{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedimaster.invalid/schema/control.schema.json",
  "title": "Launcher control message",
  "oneOf": [
    {
      "$ref": "#/$defs/HelloRequest"
    },
    {
      "$ref": "#/$defs/InstallStatusRequest"
    },
    {
      "$ref": "#/$defs/MissionsListRequest"
    },
    {
      "$ref": "#/$defs/SettingsGetRequest"
    },
    {
      "$ref": "#/$defs/SettingsSetRequest"
    },
    {
      "$ref": "#/$defs/ShowMissionRequest"
    },
    {
      "$ref": "#/$defs/BriefingGetRequest"
    },
    {
      "$ref": "#/$defs/OkReply"
    },
    {
      "$ref": "#/$defs/ErrorReply"
    },
    {
      "$ref": "#/$defs/StatusPush"
    },
    {
      "$ref": "#/$defs/SettingsChangedPush"
    },
    {
      "$ref": "#/$defs/ShowMissionPush"
    }
  ],
  "$defs": {
    "ArtScalingChange": {
      "type": "object",
      "description": "Set the art scaling to one of its values.",
      "properties": {
        "name": {
          "const": "art_scaling"
        },
        "value": {
          "enum": [
            "whole_pixels",
            "engine_fit",
            "sharp_bilinear"
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "BoxData": {
      "type": "object",
      "description": "One icon box in a sheet, all four edges inclusive.",
      "properties": {
        "left": {
          "type": "integer"
        },
        "top": {
          "type": "integer"
        },
        "right": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "additionalProperties": false
    },
    "BriefingBundle": {
      "type": "object",
      "description": "Everything the briefing player needs for one mission file.",
      "properties": {
        "format": {
          "const": "jedimaster.briefing"
        },
        "format_version": {
          "const": 1
        },
        "front_string": {
          "type": "string"
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TeamData"
          }
        },
        "briefings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BriefingData"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupData"
          }
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoxData"
          }
        },
        "craft_boxes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "iff_sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sheets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IconSheetData"
          }
        },
        "grey_sheet": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconSheetData"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "$ref": "#/$defs/FontData"
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SoundData"
          }
        }
      },
      "required": [
        "format",
        "format_version",
        "front_string",
        "teams",
        "briefings",
        "groups",
        "boxes",
        "craft_boxes",
        "iff_sheets",
        "sheets",
        "grey_sheet",
        "font",
        "sounds"
      ],
      "additionalProperties": false
    },
    "BriefingData": {
      "type": "object",
      "description": "One briefing of the mission: running time, events, label and caption texts.",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "running_time": {
          "type": "integer"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventData"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "captions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "index",
        "running_time",
        "events",
        "labels",
        "captions"
      ],
      "additionalProperties": false
    },
    "BriefingGetArgs": {
      "type": "object",
      "description": "The mission to brief: its type and its id in the network menu of that type.",
      "properties": {
        "mission_type": {
          "enum": [
            "training",
            "melee",
            "tournament",
            "combat",
            "battle",
            "campaign"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "mission_type",
        "id"
      ],
      "additionalProperties": false
    },
    "BriefingGetRequest": {
      "type": "object",
      "description": "Ask for the briefing bundle of one mission of the network menus.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "briefing.get"
        },
        "args": {
          "$ref": "#/$defs/BriefingGetArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "BriefingGetResult": {
      "type": "object",
      "description": "Whether the mission was found and read, and its briefing bundle.",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "bundle": {
          "anyOf": [
            {
              "$ref": "#/$defs/BriefingBundle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "found",
        "bundle"
      ],
      "additionalProperties": false
    },
    "ErrorBody": {
      "type": "object",
      "description": "Why the command did not run.",
      "properties": {
        "code": {
          "enum": [
            "bad_message",
            "unknown_command",
            "bad_arguments"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ErrorReply": {
      "type": "object",
      "description": "The command did not run; the reason.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "EventData": {
      "type": "object",
      "description": "One script event: its time, its type and its variables.",
      "properties": {
        "time": {
          "type": "integer"
        },
        "type": {
          "type": "integer"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "time",
        "type",
        "variables"
      ],
      "additionalProperties": false
    },
    "FontData": {
      "type": "object",
      "description": "Font 10: spacing, height, glyph widths, text colors and the atlas cells.",
      "properties": {
        "spacing": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "widths": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "text_colors": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "columns": {
          "type": "integer"
        },
        "cell_width": {
          "type": "integer"
        },
        "cell_height": {
          "type": "integer"
        },
        "picture": {
          "type": "string"
        }
      },
      "required": [
        "spacing",
        "height",
        "widths",
        "text_colors",
        "columns",
        "cell_width",
        "cell_height",
        "picture"
      ],
      "additionalProperties": false
    },
    "GroupData": {
      "type": "object",
      "description": "One flight group: what the map draws for it.",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "craft_type": {
          "type": "integer"
        },
        "iff": {
          "type": "integer"
        },
        "team": {
          "type": "integer"
        },
        "player_number": {
          "type": "integer"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PointData"
          }
        }
      },
      "required": [
        "number",
        "name",
        "craft_type",
        "iff",
        "team",
        "player_number",
        "points"
      ],
      "additionalProperties": false
    },
    "HelloArgs": {
      "type": "object",
      "description": "The page announces its own version.",
      "properties": {
        "page_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "page_version"
      ],
      "additionalProperties": false
    },
    "HelloRequest": {
      "type": "object",
      "description": "Ask the launcher to introduce itself.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "hello"
        },
        "args": {
          "$ref": "#/$defs/HelloArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "HelloResult": {
      "type": "object",
      "description": "The launcher's version and the revision of the control list.",
      "properties": {
        "launcher_version": {
          "type": "string"
        },
        "schema_revision": {
          "const": 3
        }
      },
      "required": [
        "launcher_version",
        "schema_revision"
      ],
      "additionalProperties": false
    },
    "IconSheetData": {
      "type": "object",
      "description": "One icon sheet: its name and its art name.",
      "properties": {
        "name": {
          "type": "string"
        },
        "picture": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "picture"
      ],
      "additionalProperties": false
    },
    "InstallStatusRequest": {
      "type": "object",
      "description": "Ask which install the launcher found.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "install.status"
        },
        "args": {
          "$ref": "#/$defs/NoArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "InstallStatusResult": {
      "type": "object",
      "description": "The install found (home shown as ~) and whether Balance of Power is in it.",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "balance_of_power": {
          "type": "boolean"
        }
      },
      "required": [
        "found",
        "path",
        "balance_of_power"
      ],
      "additionalProperties": false
    },
    "MenuData": {
      "type": "object",
      "description": "One mission type's network menu, or the fact that it does not resolve.",
      "properties": {
        "mission_type": {
          "type": "string"
        },
        "game_path": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuEntryData"
          }
        }
      },
      "required": [
        "mission_type",
        "game_path",
        "resolved",
        "entries"
      ],
      "additionalProperties": false
    },
    "MenuEntryData": {
      "type": "object",
      "description": "One mission the game's network menu lists.",
      "properties": {
        "section": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "available": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "section",
        "id",
        "available",
        "file",
        "title"
      ],
      "additionalProperties": false
    },
    "MissionsListRequest": {
      "type": "object",
      "description": "Ask for the network menu of every mission type.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "missions.list"
        },
        "args": {
          "$ref": "#/$defs/NoArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "MissionsListResult": {
      "type": "object",
      "description": "The network menu of every mission type.",
      "properties": {
        "menus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuData"
          }
        }
      },
      "required": [
        "menus"
      ],
      "additionalProperties": false
    },
    "NoArgs": {
      "type": "object",
      "description": "No arguments.",
      "properties": {},
      "additionalProperties": false
    },
    "OkReply": {
      "type": "object",
      "description": "The command ran; its result.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ok": {
          "const": true
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/HelloResult"
            },
            {
              "$ref": "#/$defs/InstallStatusResult"
            },
            {
              "$ref": "#/$defs/MissionsListResult"
            },
            {
              "$ref": "#/$defs/SettingsResult"
            },
            {
              "$ref": "#/$defs/ShowMissionResult"
            },
            {
              "$ref": "#/$defs/BriefingGetResult"
            }
          ]
        }
      },
      "required": [
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    "PointData": {
      "type": "object",
      "description": "One briefing point of a flight group: map x and y, and whether it is on.",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "x",
        "y",
        "enabled"
      ],
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "description": "The launcher's settings.",
      "properties": {
        "art_scaling": {
          "enum": [
            "whole_pixels",
            "engine_fit",
            "sharp_bilinear"
          ]
        }
      },
      "required": [
        "art_scaling"
      ],
      "additionalProperties": false
    },
    "SettingsChangedPush": {
      "type": "object",
      "description": "Sent to every open page after a setting changed.",
      "properties": {
        "event": {
          "const": "settings.changed"
        },
        "data": {
          "$ref": "#/$defs/SettingsResult"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    "SettingsGetRequest": {
      "type": "object",
      "description": "Ask for the settings.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "settings.get"
        },
        "args": {
          "$ref": "#/$defs/NoArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "SettingsResult": {
      "type": "object",
      "description": "The settings as they stand.",
      "properties": {
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "settings"
      ],
      "additionalProperties": false
    },
    "SettingsSetRequest": {
      "type": "object",
      "description": "Change one setting.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "settings.set"
        },
        "args": {
          "$ref": "#/$defs/ArtScalingChange"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "ShowMissionArgs": {
      "type": "object",
      "description": "The mission to show: its type and its id in the network menu of that type.",
      "properties": {
        "mission_type": {
          "enum": [
            "training",
            "melee",
            "tournament",
            "combat",
            "battle",
            "campaign"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "mission_type",
        "id"
      ],
      "additionalProperties": false
    },
    "ShowMissionPush": {
      "type": "object",
      "description": "Sent to every open page when a mission is to be shown.",
      "properties": {
        "event": {
          "const": "page.show_mission"
        },
        "data": {
          "$ref": "#/$defs/ShownMission"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    "ShowMissionRequest": {
      "type": "object",
      "description": "Tell every open page to show one mission of the network menus.",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "const": "page.show_mission"
        },
        "args": {
          "$ref": "#/$defs/ShowMissionArgs"
        }
      },
      "required": [
        "id",
        "command",
        "args"
      ],
      "additionalProperties": false
    },
    "ShowMissionResult": {
      "type": "object",
      "description": "Whether the mission was found in its menu and so shown.",
      "properties": {
        "shown": {
          "type": "boolean"
        }
      },
      "required": [
        "shown"
      ],
      "additionalProperties": false
    },
    "ShownMission": {
      "type": "object",
      "description": "The mission a page is told to show.",
      "properties": {
        "mission_type": {
          "enum": [
            "training",
            "melee",
            "tournament",
            "combat",
            "battle",
            "campaign"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "mission_type",
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "SoundData": {
      "type": "object",
      "description": "One sound the player uses: its name in the game's list and its art name.",
      "properties": {
        "name": {
          "type": "string"
        },
        "picture": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "picture"
      ],
      "additionalProperties": false
    },
    "StatusData": {
      "type": "object",
      "description": "What the launcher tells a page that just connected.",
      "properties": {
        "launcher_version": {
          "type": "string"
        },
        "install_found": {
          "type": "boolean"
        }
      },
      "required": [
        "launcher_version",
        "install_found"
      ],
      "additionalProperties": false
    },
    "StatusPush": {
      "type": "object",
      "description": "Sent to a page when it connects.",
      "properties": {
        "event": {
          "const": "status"
        },
        "data": {
          "$ref": "#/$defs/StatusData"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": false
    },
    "TeamData": {
      "type": "object",
      "description": "One team: its name and the briefing it sees (None: the default one).",
      "properties": {
        "team": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "name": {
          "type": "string"
        },
        "briefing": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "team",
        "name",
        "briefing"
      ],
      "additionalProperties": false
    }
  }
}
