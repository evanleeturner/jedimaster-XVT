{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedimaster.invalid/schema/result.schema.json",
  "title": "Launch result",
  "description": "How a --launch battle ended: what the battle wrote into the pilot record, or why it did not run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "exit_code",
    "outcome",
    "score",
    "kills",
    "losses",
    "goals_met_seconds",
    "why",
    "sith",
    "local_entry",
    "players",
    "teams",
    "detail"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "status": {
      "enum": [
        "flown",
        "refused",
        "not_reached",
        "failed"
      ]
    },
    "exit_code": {
      "description": "The engine's exit code: 0 flown, 3 refused, 4 not reached, 5 failed.",
      "enum": [
        0,
        3,
        4,
        5
      ]
    },
    "outcome": {
      "enum": [
        "none",
        "completed",
        "not_completed"
      ]
    },
    "kills": {
      "type": "integer",
      "minimum": 0
    },
    "losses": {
      "type": "integer",
      "minimum": 0
    },
    "goals_met_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds into the mission when the pilot's team met its goals; 0 when it never did."
    },
    "score": {
      "description": "The pilot's score; below zero when the pilot leaves a melee early.",
      "type": "integer"
    },
    "why": {
      "description": "A plain sentence when the battle was not flown; empty otherwise.",
      "type": "string"
    },
    "sith": {
      "description": "The battle's Sith setting and how the Sith flight fared; destroyed is lost, a craft that jumped away or flew on lived.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "flight_group",
        "flight_name",
        "craft_type",
        "apprentices_flown",
        "apprentices_lost",
        "lord_flown",
        "lord_lost",
        "why"
      ],
      "properties": {
        "setting": {
          "enum": [
            "none",
            "apprentices",
            "lord"
          ]
        },
        "flight_group": {
          "description": "The promoted flight group's index; -1 when none was promoted.",
          "type": "integer",
          "minimum": -1
        },
        "flight_name": {
          "description": "The promoted group's name from the mission; empty when none.",
          "type": "string"
        },
        "craft_type": {
          "description": "The promoted group's craft type number; -1 when none.",
          "type": "integer",
          "minimum": -1
        },
        "apprentices_flown": {
          "type": "integer",
          "minimum": 0
        },
        "apprentices_lost": {
          "type": "integer",
          "minimum": 0
        },
        "lord_flown": {
          "type": "integer",
          "minimum": 0
        },
        "lord_lost": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "description": "Empty when a group was promoted or the setting is none; else why none was.",
          "type": "string"
        }
      }
    },
    "local_entry": {
      "description": "The local pilot's place in the pilot record; -1 when it has none.",
      "type": "integer",
      "minimum": -1,
      "maximum": 7
    },
    "players": {
      "description": "Every filled entry of the pilot record's players, in entry order.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "description": "One player as the game's end of battle counted it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "slot",
          "name",
          "team",
          "flight_group",
          "rating",
          "score",
          "kills",
          "shared",
          "assists",
          "losses",
          "shots",
          "hits",
          "warheads",
          "warhead_hits",
          "has_left"
        ],
        "properties": {
          "entry": {
            "description": "The player's place in the pilot record.",
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "slot": {
            "description": "The player's place in the flight; -1 when no place holds the player, and then team is -1 and the flight's counts are 0.",
            "type": "integer",
            "minimum": -1,
            "maximum": 7
          },
          "name": {
            "description": "The name the debriefing shows.",
            "type": "string",
            "maxLength": 12
          },
          "team": {
            "type": "integer",
            "minimum": -1
          },
          "flight_group": {
            "type": "integer",
            "minimum": 0
          },
          "rating": {
            "description": "The rank at launch, as a number.",
            "type": "integer"
          },
          "score": {
            "description": "The player's score plus its team's bonus.",
            "type": "integer"
          },
          "kills": {
            "type": "integer"
          },
          "shared": {
            "type": "integer"
          },
          "assists": {
            "type": "integer"
          },
          "losses": {
            "type": "integer"
          },
          "shots": {
            "description": "Laser and ion shots.",
            "type": "integer"
          },
          "hits": {
            "description": "Laser and ion hits.",
            "type": "integer"
          },
          "warheads": {
            "type": "integer"
          },
          "warhead_hits": {
            "type": "integer"
          },
          "has_left": {
            "description": "True when the player left before the end.",
            "type": "boolean"
          }
        }
      }
    },
    "teams": {
      "description": "Each of teams 0 to 7 that had a player flight group arrive or met its goals.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "description": "One team of the battle.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "team",
          "completed",
          "score",
          "kills",
          "shared",
          "losses",
          "seconds"
        ],
        "properties": {
          "team": {
            "description": "The team's number.",
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "completed": {
            "description": "True when its primary goals were met and none prevented.",
            "type": "boolean"
          },
          "score": {
            "type": "integer"
          },
          "kills": {
            "type": "integer"
          },
          "shared": {
            "type": "integer"
          },
          "losses": {
            "type": "integer"
          },
          "seconds": {
            "description": "When the team met its goals; 0 when it never did.",
            "type": "integer"
          }
        }
      }
    },
    "detail": {
      "description": "The local pilot's own record of the battle, the numbers its debriefing shows; each machine keeps only its own pilot's.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shots",
        "hits",
        "warheads",
        "warhead_hits",
        "losses",
        "losses_to_collisions",
        "losses_to_starships",
        "losses_to_mines",
        "friendlies_killed",
        "special_inspected",
        "by_craft",
        "on_pilot_ranks",
        "on_ai_ranks",
        "killed_by_pilot_ranks",
        "killed_by_ai_ranks",
        "on_players",
        "from_players",
        "on_flight_groups",
        "from_flight_groups"
      ],
      "properties": {
        "shots": {
          "type": "integer"
        },
        "hits": {
          "type": "integer"
        },
        "warheads": {
          "type": "integer"
        },
        "warhead_hits": {
          "type": "integer"
        },
        "losses": {
          "type": "integer"
        },
        "losses_to_collisions": {
          "type": "integer"
        },
        "losses_to_starships": {
          "type": "integer"
        },
        "losses_to_mines": {
          "type": "integer"
        },
        "friendlies_killed": {
          "type": "integer"
        },
        "special_inspected": {
          "type": "integer"
        },
        "by_craft": {
          "description": "The rows of kills by craft type with a number other than 0, lowest craft_type first.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "description": "One row of kills by craft type.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "craft_type",
              "kills",
              "shared",
              "assists"
            ],
            "properties": {
              "craft_type": {
                "description": "The row's craft_type.",
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              },
              "assists": {
                "type": "integer"
              }
            }
          }
        },
        "on_pilot_ranks": {
          "description": "The rows of kills of human pilots by rank with a number other than 0, lowest rank first.",
          "type": "array",
          "maxItems": 25,
          "items": {
            "description": "One row of kills of human pilots by rank.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "kills",
              "shared",
              "assists"
            ],
            "properties": {
              "rank": {
                "description": "The row's rank.",
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              },
              "assists": {
                "type": "integer"
              }
            }
          }
        },
        "on_ai_ranks": {
          "description": "The rows of kills of computer pilots by rank with a number other than 0, lowest rank first.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "description": "One row of kills of computer pilots by rank.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "kills",
              "shared",
              "assists"
            ],
            "properties": {
              "rank": {
                "description": "The row's rank.",
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              },
              "assists": {
                "type": "integer"
              }
            }
          }
        },
        "killed_by_pilot_ranks": {
          "description": "The rows of deaths by the human killer's rank with a number other than 0, lowest rank first.",
          "type": "array",
          "maxItems": 25,
          "items": {
            "description": "One row of deaths by the human killer's rank.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "times"
            ],
            "properties": {
              "rank": {
                "description": "The row's rank.",
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              },
              "times": {
                "type": "integer"
              }
            }
          }
        },
        "killed_by_ai_ranks": {
          "description": "The rows of deaths by the computer killer's rank with a number other than 0, lowest rank first.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "description": "One row of deaths by the computer killer's rank.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "times"
            ],
            "properties": {
              "rank": {
                "description": "The row's rank.",
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "times": {
                "type": "integer"
              }
            }
          }
        },
        "on_players": {
          "description": "The rows of the pilot's kills of each player with a number other than 0, lowest entry first.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "description": "One row of the pilot's kills of each player.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "kills",
              "shared"
            ],
            "properties": {
              "entry": {
                "description": "The row's entry.",
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              }
            }
          }
        },
        "from_players": {
          "description": "The rows of each player's kills of the pilot with a number other than 0, lowest entry first.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "description": "One row of each player's kills of the pilot.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "kills",
              "shared"
            ],
            "properties": {
              "entry": {
                "description": "The row's entry.",
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              }
            }
          }
        },
        "on_flight_groups": {
          "description": "The rows of the pilot's kills of each flight group with a number other than 0, lowest flight_group first.",
          "type": "array",
          "maxItems": 48,
          "items": {
            "description": "One row of the pilot's kills of each flight group.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flight_group",
              "kills",
              "shared"
            ],
            "properties": {
              "flight_group": {
                "description": "The row's flight_group.",
                "type": "integer",
                "minimum": 0,
                "maximum": 47
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              }
            }
          }
        },
        "from_flight_groups": {
          "description": "The rows of each flight group's kills of the pilot with a number other than 0, lowest flight_group first.",
          "type": "array",
          "maxItems": 48,
          "items": {
            "description": "One row of each flight group's kills of the pilot.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flight_group",
              "kills",
              "shared"
            ],
            "properties": {
              "flight_group": {
                "description": "The row's flight_group.",
                "type": "integer",
                "minimum": 0,
                "maximum": 47
              },
              "kills": {
                "type": "integer"
              },
              "shared": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
