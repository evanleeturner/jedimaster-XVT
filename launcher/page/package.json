{
  "name": "jedimaster-launcher-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The local web page of the jedimaster launcher",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --test 'src/**/*.test.ts'",
    "gen:types": "json2ts --input ../schema/control.schema.json --output src/generated/control.ts",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-public.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
