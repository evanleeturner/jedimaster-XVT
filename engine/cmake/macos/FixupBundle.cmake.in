set(bundle "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/OpenXvT.app")

if(NOT IS_DIRECTORY "${bundle}")
    message(FATAL_ERROR "OpenXvT application bundle was not installed: ${bundle}")
endif()

include(BundleUtilities)
set(BU_CHMOD_BUNDLE_ITEMS TRUE)
fixup_bundle("${bundle}" "" "@XVT_MACOS_DEPENDENCY_DIRS@")
