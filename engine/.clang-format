---
# K&R layout in the Linux kernel's form: 8-column tabs, an 80-column
# target, a function's opening brace on its own line, a control
# statement's on the same line, and braces on every control body.
BasedOnStyle: LLVM
IndentWidth: 8
UseTab: Always
ContinuationIndentWidth: 8
BreakBeforeBraces: Linux
InsertBraces: true
IndentCaseLabels: false
ColumnLimit: 80
# A string is never split, so a message can still be found by searching
# for it.
BreakStringLiterals: false
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - {Regex: '^<', Priority: 2}
  - {Regex: '.*', Priority: 3}
SpaceBeforeParens: ControlStatementsExceptForEachMacros
# Comments keep their words and line breaks; only their indentation moves.
ReflowComments: IndentOnly
